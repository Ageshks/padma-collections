{
  "name": "padma-functions",
  "description": "Padma Collections server-side Cloudinary gateway. The Cloudinary API secret exists ONLY here — never in the Flutter app, Firestore or git.",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2"
  }
}
