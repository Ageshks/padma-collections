app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Firebase / Android release signing -----------------------------------
# Never commit: the upload keystore and its passwords.
android/key.properties
*.jks
*.keystore

# --- Cloudinary credentials ----------------------------------------------
# The Cloudinary API secret must NEVER be committed and must never reach the
# Flutter app. It lives only in Firebase Secret Manager, injected into the
# Cloud Functions runtime at deploy time:
#
#   firebase functions:secrets:set CLOUDINARY_API_SECRET
#
# These patterns are a backstop against an accidental `source .env`.
.env
.env.*
functions/.env
functions/.env.*

# Generated security-rules test artifacts
tool/node_modules/
tool/.emulator.log
tool/package-lock.json
